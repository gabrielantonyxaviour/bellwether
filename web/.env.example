# Bellwether web — build-time config. Copy to .env.local (git-ignored) and fill in.
# Any value can also be set at runtime in public/config.json (same keys without VITE_, camelCase).

# fork | devnet | mainnet  (default devnet)
VITE_CLUSTER=devnet
# Optional: defaults are api.devnet / api.mainnet-beta / http://127.0.0.1:8899 (fork)
VITE_RPC_URL=
# Optional: derived from the RPC URL (fork: port + 1)
VITE_WS_URL=
# Venue program id and VenueConfig PDA on this cluster (from the deploy)
VITE_PROGRAM_ID=
VITE_VENUE=
# Quote mint: defaults to mainnet USDC on fork and mainnet; required on devnet (test USDC)
VITE_USDC_MINT=
# Rehearsal stock mint (BWRS, Token-2022) on this cluster
VITE_BWRS_MINT=
# Symbol the Trade / Liquidity nav opens (default FWDI on fork, BWRS elsewhere)
VITE_DEFAULT_SYMBOL=
# Venue API (services/api): /tape /symbols /venue /halts  (default http://localhost:8787)
VITE_API_BASE_URL=
# Credential issuer (services/credential): /admit /revoke /credential/:wallet  (default http://localhost:8790)
VITE_CREDENTIAL_API_URL=

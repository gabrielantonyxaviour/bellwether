{
  "name": "bellwether",
  "private": true,
  "type": "module",
  "description": "Permissioned pools and an operator workbench for the SEC Innovation Exemption, on Solana",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "program:build": "cargo build-sbf --manifest-path programs/venue/Cargo.toml",
    "program:test": "cargo test --manifest-path programs/venue/Cargo.toml"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana-program/token-2022": "0.19.0",
    "@solana/kit": "8.3.0",
    "hono": "^4.13.9",
    "sas-lib": "1.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
